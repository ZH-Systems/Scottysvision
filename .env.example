# Vercel > Project > Settings > Environment Variables. Never commit real values.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_OR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=vision-attachments
# Optional: restrict kitchen login to a comma-separated set of existing Auth users.
VISION_ALLOWED_EMAILS=
# Optional existing Sheets integration, explicit preview/approval remains required.
VISION_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Required before any shared-workbook call is allowed. Add approved login emails.
VISION_SHEETS_ALLOWED_EMAILS=
