{
  "name": "scottys-vision-kitchen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run test && npm run typecheck && npm run build && npm run test:production && npm run test:integration",
    "test:production": "node scripts/smoke-production.mjs",
    "postbuild": "node scripts/build-service-worker.mjs",
    "test:integration": "node scripts/integration-production.mjs",
    "push:keys": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "fflate": "^0.8.3",
    "google-auth-library": "^10.0.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "5.9.3"
  }
}
